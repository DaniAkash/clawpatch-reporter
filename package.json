{
  "name": "clawpatch-reporter",
  "version": "0.0.1",
  "description": "CLI that renders clawpatch findings into GitHub-flavored Markdown or semantic HTML reports.",
  "license": "MIT",
  "author": "Dani Akash",
  "homepage": "https://github.com/DaniAkash/clawpatch-reporter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniAkash/clawpatch-reporter.git"
  },
  "bugs": "https://github.com/DaniAkash/clawpatch-reporter/issues",
  "keywords": [
    "clawpatch",
    "code-review",
    "report",
    "markdown",
    "html",
    "cli"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "clawpatch-reporter": "./dist/cli.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "bunup": "^0.16.31",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
